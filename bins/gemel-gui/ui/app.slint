// The gemel main window, after uigtk3.ml's createToplevelWindow: the menu
// bar, the toolbar, the items, the details pane and the status line; and
// uigtk3's dialogs (warnBox, fatalError, the root selection), drawn as
// cards over the window, since Slint has no window-modal dialog.
//
// The items are a custom table on ListView, as StandardTableView is
// single-select with text-only cells. What the rows show, the selection
// and what is enabled are worked out in Rust (src/lib.rs and
// src/recon_view.rs); this file renders them and forwards input.

import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, RadioGroup, ScrollView } from "std-widgets.slint";

export struct RowData {
    // The replicas' statuses (`reconItem2stringList`).
    replica1: string,
    replica2: string,
    // The action, as the text interface draws it (`action2niceString`).
    arrow: string,
    // 0 error, 1 skip, 2 propagate or merge, 3 partial
    arrow-kind: int,
    // The action isn't the default (getArrow's light blue).
    changed: bool,
    // 0 nothing, 1 done, 2 failed
    done: int,
    status: string,
    path: string,
    selected: bool,
    spoken: string,
}

// A profile, as the profile manager lists it.
export struct ProfileRow {
    name: string,
    label: string,
}

// A profile with a key (`profileKeymap`).
export struct ProfileKey {
    key: int,
    name: string,
}

// A line of a diff, and how to colour it: 0 plain, 1 added, 2 removed,
// 3 a location.
export struct DiffLine {
    text: string,
    kind: int,
}

// A section of the manual that has a topic, for the Help menu.
export struct DocTopic {
    short: string,
    name: string,
}

// A preference a profile sets, as the profile editor lists it.
export struct EditorRow {
    name: string,
    type: string,
    value: string,
}

// A row of the tree a preference is added from: 0 a group, 1 a topic, 2
// a preference.
export struct PrefTreeRow {
    title: string,
    kind: int,
    depth: int,
    parent: bool,
    expanded: bool,
}

// An item the summary box lists (`summaryBox`).
export struct SummaryEntry {
    path: string,
    description: string,
    errors: [string],
}

global Theme {
    out property <length> row-height: 20px;
    out property <length> replica-width: 110px;
    out property <length> arrow-width: 64px;
    out property <length> status-width: 80px;

    // getArrow's pixmap colours.
    public pure function arrow-color(kind: int, changed: bool) -> color {
        if kind == 0 { return #ff2040; }
        if changed { return #8888ff; }
        if kind == 1 { return #ff2040; }
        if kind == 3 { return #ff9303; }
        return #00b000;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    Text {
        x: 4px;
        width: parent.width - 4px;
        text: root.label;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A dialog's frame: the scrim that swallows input, and the card.
component Card inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 460px;
    callback escape();
    background: #00000080;
    TouchArea { }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            reject
        }
        Rectangle {
            x: (root.width - self.width) / 2;
            y: max(16px, (root.height - self.height) / 3);
            width: min(root.card-width, root.width - 32px);
            height: min(self.preferred-height, root.height - 32px);
            border-radius: 8px;
            background: Palette.background;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            accessible-role: groupbox;
            accessible-label: root.title;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.title;
                    font-weight: 700;
                    font-size: 15px;
                }
                @children
            }
        }
    }
}

// A paragraph: word-wrapped text, as tall as its lines. In a layout in a
// card, Slint 1.18 counts a wrapped text as one line, so that the card
// cut off what came after it; the text's own preferred height, for its
// width, is right.
component Para inherits Text {
    wrap: word-wrap;
    min-height: self.preferred-height;
}

// The documentation of a preference (`documentPreference`), greyed out
// with none selected.
component DocPane inherits VerticalLayout {
    in property <bool> shown;
    in property <string> short;
    in property <styled-text> long;
    spacing: 6px;
    Text {
        text: "Documentation";
        font-weight: 700;
    }
    GridLayout {
        padding-left: 12px;
        spacing: 6px;
        Row {
            Text {
                text: "Short description:";
                color: root.shown ? Palette.foreground : Palette.border;
            }
            Para {
                text: root.short;
                accessible-label: "Short description";
            }
        }
        Row {
            Text {
                colspan: 2;
                text: "Long description:";
                color: root.shown ? Palette.foreground : Palette.border;
            }
        }
        Row {
            Rectangle {
                colspan: 2;
                height: 128px;
                background: Palette.control-background;
                border-width: 1px;
                border-color: Palette.border;
                ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        StyledText {
                            text: root.long;
                            default-color: Palette.foreground;
                        }
                    }
                }
            }
        }
    }
}

// A list of rows 22px high, in a frame, with keys: Up and Down choose
// the row before or after the one selected (`step`), Enter activates it,
// and Left and Right are for a tree. Its `ListView` binds its `content-y`
// to `scroll`, and gives its `visible-height`, so that the row selected
// is kept in view.
//
// Screen readers see the list here, where the keys go, as `label`, with
// the focus on the row selected, as Slint's own list views delegate it;
// the `ListView` inside is hidden from them (`accessible-role: none`).
// The focus's index counts the rows the `ListView` has made, which start
// at the first one shown.
component KeyedList inherits FocusScope {
    in property <string> label;
    in property <int> count;
    in property <int> selected: -1;
    in property <length> list-height: 220px;
    in-out property <length> scroll;
    in property <length> view-height;
    in property <bool> tree;
    // Takes the keys when its card opens.
    in property <bool> first-focus;
    init => {
        if root.first-focus { root.focus(); }
    }
    callback step(row: int);
    callback activate(row: int);
    callback left(row: int);
    callback right(row: int);
    key-pressed(event) => {
        if event.modifiers.control || event.modifiers.meta || event.modifiers.alt {
            return reject;
        }
        if event.text == Key.UpArrow {
            if root.count > 0 { root.step(max(0, root.selected - 1)); }
            return accept;
        }
        if event.text == Key.DownArrow {
            if root.count > 0 { root.step(min(root.count - 1, root.selected + 1)); }
            return accept;
        }
        if event.text == Key.Return && root.selected >= 0 {
            root.activate(root.selected);
            return accept;
        }
        if root.tree && event.text == Key.LeftArrow && root.selected >= 0 {
            root.left(root.selected);
            return accept;
        }
        if root.tree && event.text == Key.RightArrow && root.selected >= 0 {
            root.right(root.selected);
            return accept;
        }
        reject
    }
    changed selected => {
        if root.selected >= 0 {
            if root.selected * 22px < -root.scroll {
                root.scroll = -root.selected * 22px;
            } else if (root.selected + 1) * 22px > -root.scroll + root.view-height {
                root.scroll = -((root.selected + 1) * 22px - root.view-height);
            }
        }
    }
    accessible-role: list;
    accessible-label: root.label;
    accessible-item-count: root.count;
    accessible-delegate-focus: root.selected - floor(-root.scroll / 22px);
    // A FocusScope isn't a layout: its height is given here, and the
    // frame fills it.
    min-height: root.list-height;
    preferred-height: root.list-height;
    Rectangle {
        background: Palette.control-background;
        border-width: 1px;
        border-color: root.has-focus ? Palette.accent-background : Palette.border;
        @children
    }
}

// A preference's row in a list: its cells, the row selected highlighted.
component ListRow inherits Rectangle {
    in property <bool> selected;
    in property <string> label;
    in property <int> index;
    callback clicked();
    callback double-clicked();
    height: 22px;
    background: root.selected ? Palette.accent-background : transparent;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-item-index: root.index;
    accessible-action-default => { root.clicked(); }
    TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
    @children
}

export component AppWindow inherits Window {
    in property <string> window-title: "Gemel";
    title: root.window-title;
    preferred-width: 900px;
    preferred-height: 640px;

    in property <[RowData]> rows;
    // The keyboard cursor's row, -1 if there is none.
    in property <int> cursor: -1;
    in property <string> replica1-heading: " ";
    in property <string> replica2-heading: " ";
    in property <string> profile-text: "No profile";
    in property <string> status-text;
    in property <string> details-path;
    in property <string> details-text;
    // The details are uigtk3's formatted ones (monospace), not an error.
    in property <bool> details-formatted;
    in property <string> mono-font: "Menlo";
    // The action menu's directions (`buildActionMenu`).
    in property <string> left-to-right: "Left to Right";
    in property <string> right-to-left: "Right to Left";
    // uigtk3's groups of what is sensitive together.
    in property <bool> actions-enabled;
    in property <bool> go-enabled;
    in property <bool> detail-enabled;
    in property <bool> rescan-enabled;
    in property <bool> diff-enabled;
    // The Expert menu, shown with `expert`, and its check marks.
    in property <bool> expert;
    in property <bool> debug-all;
    in property <bool> debug-verbose;
    in property <bool> debug-update;
    // The profiles bound to keys.
    in property <[ProfileKey]> profile-keys;
    // The Help menu's sections of the manual.
    in property <[DocTopic]> doc-topics;
    in property <bool> stop-enabled;
    // The overall progress (`displayGlobalProgress`), pulsing while
    // updates are detected.
    in property <float> progress-fraction;
    in property <string> progress-text;
    in property <bool> progress-pulse;
    // The summary box's items.
    in property <[SummaryEntry]> summary-entries;

    // The dialog shown, if any: 0 none, 1 a message, 2 the first root,
    // 3 the second root, 4 the summary, 5 ssh's password, 6 the profile
    // manager, 7 the profile creation assistant.
    in property <int> dialog;
    in property <string> dialog-title;
    in property <string> dialog-message;
    // The buttons; "" leaves one out.
    in property <string> dialog-ok: "OK";
    in property <string> dialog-cancel;
    // The root selection's fields.
    in-out property <string> root-dir;
    // 0 local, 1 ssh, 2 socket
    in-out property <int> root-kind;
    in-out property <string> root-host;
    in-out property <string> root-user;
    in-out property <string> root-port;
    in property <string> root-error;
    // The password dialog's root, its entry, and whether it is still
    // asked for.
    in property <string> password-root;
    in-out property <string> password-text;
    in property <bool> password-editable;
    // The profile manager (`getProfile`): the profiles, the one selected
    // (-1 for none), its roots if it has two, and whether closing it quits.
    in property <[ProfileRow]> profiles;
    in property <int> profile-selected: -1;
    in property <string> profile-root1;
    in property <string> profile-root2;
    in property <bool> manager-quit;
    // The profile editor (`editProfile`): its rows, the one selected (-1
    // for none), whether there is something to write, and the order.
    in property <string> editor-title;
    in property <[EditorRow]> editor-rows;
    in property <int> editor-selected: -1;
    in property <bool> editor-modified;
    in property <bool> editor-descending;
    // The documentation of the preference selected (`documentPreference`),
    // in the editor and in the tree.
    in property <bool> doc-shown;
    in property <string> doc-short;
    in property <styled-text> doc-long;
    // A preference edited (`editPreference`), edited as a boolean (0), a
    // line of text (1) or a list (2).
    in property <string> pe-name;
    in property <string> pe-description;
    in property <string> pe-type;
    in property <int> pe-kind;
    in-out property <bool> pe-truth;
    in-out property <string> pe-text;
    in property <[string]> pe-items;
    in property <int> pe-item: -1;
    in-out property <string> pe-entry;
    // The tree a preference is added from (`addPreference`).
    in property <[PrefTreeRow]> tree-rows;
    in property <int> tree-selected: -1;
    in property <bool> tree-all;
    in property <bool> tree-can-add;
    // The assistant (`createProfile`): its page, what is entered, and
    // what the pages say, which Rust works out on each change.
    in property <int> wiz-page;
    in property <string> wiz-title;
    in-out property <string> wiz-name;
    in-out property <string> wiz-label;
    in property <bool> wiz-exists;
    in-out property <int> wiz-kind;
    in-out property <string> wiz-host;
    in-out property <string> wiz-user;
    in-out property <string> wiz-port;
    in-out property <bool> wiz-compress;
    in-out property <int> wiz-dir-kind;
    in-out property <string> wiz-first;
    in-out property <string> wiz-second;
    in-out property <string> wiz-remote;
    in-out property <bool> wiz-fat;
    in property <bool> wiz-fat-shown: true;
    in property <bool> wiz-complete;
    in property <string> wiz-kind-text;
    in property <string> wiz-requirement;
    in property <string> wiz-connection;
    in property <string> wiz-first-label;
    in property <string> wiz-second-label;
    in property <string> wiz-remote-note;
    in property <string> wiz-conclusion;

    callback row-clicked(index: int, shift: bool, command: bool);
    callback move-cursor(delta: int, extend: bool);
    // An action on the selection: "right", "left", "skip", "merge",
    // "first", "second", "newer", "older", "force-newer", "force-older",
    // "revert", "merge-default".
    callback action(name: string);
    callback select-all();
    callback deselect-all();
    callback details();
    callback diff();
    // "path", "ext" or "name".
    callback ignore(kind: string);
    // "name", "size", "new-first" or "default".
    callback sort(kind: string);
    callback debug(module: string, on: bool);
    callback select-profile(key: int);
    callback go();
    callback stop();
    callback rescan();
    // "Detect Updates and Proceed (Without Waiting)".
    callback proceed();
    // "Recheck Unsynchronized Items".
    callback recheck();
    callback show-statistics();
    callback change-profile();
    callback profile-clicked(index: int);
    callback profile-open();
    callback profile-close();
    callback profile-add();
    callback profile-delete();
    callback profile-edit();
    callback editor-clicked(row: int);
    callback editor-activated(row: int);
    callback editor-sort();
    callback editor-add();
    callback editor-edit();
    callback editor-delete();
    callback editor-apply();
    callback editor-close(ok: bool);
    callback pe-item-clicked(index: int);
    callback pe-add();
    callback pe-remove();
    callback pe-edit();
    callback pe-up();
    callback pe-down();
    callback pe-close(ok: bool);
    callback tree-clicked(row: int);
    callback tree-select(row: int);
    callback tree-activated(row: int);
    callback tree-left(row: int);
    callback tree-right(row: int);
    callback tree-toggle-all();
    callback tree-close(ok: bool);
    callback wizard-changed();
    callback wizard-back();
    callback wizard-next();
    callback wizard-cancel();
    callback wizard-apply();
    // 0 the first replica, 1 the second.
    callback wizard-browse(which: int);
    callback quit();
    callback dialog-done(ok: bool);
    callback browse-root();
    callback root-help();
    // The manual's window, at a section ("" for the first).
    callback documentation(topic: string);

    // Scrolls so that row `index` is visible.
    public function bring-into-view(index: int) {
        if index * Theme.row-height < -list.content-y {
            list.content-y = -index * Theme.row-height;
        } else if (index + 1) * Theme.row-height > -list.content-y + list.visible-height {
            list.content-y = -((index + 1) * Theme.row-height - list.visible-height);
        }
    }

    public function focus-table() {
        table-scope.focus();
    }

    // Native on macOS (through muda inside Slint), where `Control` is Cmd.
    // Keys without modifiers are taken by the table (below): a native menu
    // would take them from text fields too.
    MenuBar {
        Menu {
            title: "Synchronization";
            MenuItem {
                title: "Go";
                enabled: root.go-enabled;
                activated => { root.go(); }
            }
            MenuItem {
                title: "Rescan";
                enabled: root.rescan-enabled;
                activated => { root.rescan(); }
            }
            MenuItem {
                title: "Detect Updates and Proceed (Without Waiting)";
                enabled: root.rescan-enabled;
                activated => { root.proceed(); }
            }
            MenuItem {
                title: "Recheck Unsynchronized Items";
                enabled: root.rescan-enabled;
                activated => { root.recheck(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Change Profile...";
                enabled: root.rescan-enabled;
                activated => { root.change-profile(); }
            }
            for p in root.profile-keys: MenuItem {
                title: "Select profile " + p.name + "  (" + p.key + ")";
                enabled: root.rescan-enabled;
                activated => { root.select-profile(p.key); }
            }
            if root.profile-keys.length > 0: MenuSeparator { }
            MenuItem {
                title: "Show Statistics";
                activated => { root.show-statistics(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Quit";
                shortcut: @keys(Control + Q);
                activated => { root.quit(); }
            }
        }
        Menu {
            title: "Actions";
            MenuItem {
                title: "Select All";
                enabled: root.rescan-enabled;
                shortcut: @keys(Control + A);
                activated => { root.select-all(); }
            }
            MenuItem {
                title: "Deselect All";
                enabled: root.rescan-enabled;
                shortcut: @keys(Control + Shift + A);
                activated => { root.deselect-all(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Propagate " + root.left-to-right;
                enabled: root.actions-enabled;
                activated => { root.action("right"); }
            }
            MenuItem {
                title: "Propagate " + root.right-to-left;
                enabled: root.actions-enabled;
                activated => { root.action("left"); }
            }
            MenuItem {
                title: "Do Not Propagate Changes";
                enabled: root.actions-enabled;
                activated => { root.action("skip"); }
            }
            MenuItem {
                title: "Merge the Files";
                enabled: root.actions-enabled;
                activated => { root.action("merge"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Resolve Conflicts in Favor of First Root";
                enabled: root.actions-enabled;
                activated => { root.action("first"); }
            }
            MenuItem {
                title: "Resolve Conflicts in Favor of Second Root";
                enabled: root.actions-enabled;
                activated => { root.action("second"); }
            }
            MenuItem {
                title: "Resolve Conflicts in Favor of Most Recently Modified";
                enabled: root.actions-enabled;
                activated => { root.action("newer"); }
            }
            MenuItem {
                title: "Resolve Conflicts in Favor of Least Recently Modified";
                enabled: root.actions-enabled;
                activated => { root.action("older"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Force Newer Files to Replace Older Ones";
                enabled: root.actions-enabled;
                activated => { root.action("force-newer"); }
            }
            MenuItem {
                title: "Force Older Files to Replace Newer Ones";
                enabled: root.actions-enabled;
                activated => { root.action("force-older"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Revert to Unison's Recommendation";
                enabled: root.actions-enabled;
                activated => { root.action("revert"); }
            }
            MenuItem {
                title: "Revert to the Merging Default, if Available";
                enabled: root.actions-enabled;
                activated => { root.action("merge-default"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Show Diffs";
                enabled: root.diff-enabled;
                activated => { root.diff(); }
            }
            MenuItem {
                title: "Detailed Information";
                enabled: root.detail-enabled;
                activated => { root.details(); }
            }
        }
        Menu {
            title: "Ignore";
            MenuItem {
                title: "Permanently Ignore This Path";
                enabled: root.actions-enabled;
                activated => { root.ignore("path"); }
            }
            MenuItem {
                title: "Permanently Ignore Files with this Extension";
                enabled: root.actions-enabled;
                activated => { root.ignore("ext"); }
            }
            MenuItem {
                title: "Permanently Ignore Files with this Name (in any Dir)";
                enabled: root.actions-enabled;
                activated => { root.ignore("name"); }
            }
        }
        Menu {
            title: "Sort";
            MenuItem {
                title: "Sort by Name";
                enabled: root.rescan-enabled;
                activated => { root.sort("name"); }
            }
            MenuItem {
                title: "Sort by Size";
                enabled: root.rescan-enabled;
                activated => { root.sort("size"); }
            }
            MenuItem {
                title: "Sort New Entries First (toggle)";
                enabled: root.rescan-enabled;
                activated => { root.sort("new-first"); }
            }
            MenuItem {
                title: "Default Ordering";
                enabled: root.rescan-enabled;
                activated => { root.sort("default"); }
            }
        }
        if root.expert: Menu {
            title: "Expert";
            MenuItem {
                title: "Debug 'all'";
                checkable: true;
                checked: root.debug-all;
                activated => { root.debug("all", !root.debug-all); }
            }
            MenuItem {
                title: "Debug 'verbose'";
                checkable: true;
                checked: root.debug-verbose;
                activated => { root.debug("verbose", !root.debug-verbose); }
            }
            MenuItem {
                title: "Debug 'update'";
                checkable: true;
                checked: root.debug-update;
                activated => { root.debug("update", !root.debug-update); }
            }
        }
        Menu {
            title: "Help";
            for t in root.doc-topics: MenuItem {
                title: t.name;
                activated => { root.documentation(t.short); }
            }
        }
    }

    VerticalLayout {
        // The toolbar, and the profile's name.
        HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            Button {
                text: "Left to Right";
                enabled: root.actions-enabled;
                clicked => { root.action("right"); table-scope.focus(); }
            }
            Button {
                text: "Skip";
                enabled: root.actions-enabled;
                clicked => { root.action("skip"); table-scope.focus(); }
            }
            Button {
                text: "Right to Left";
                enabled: root.actions-enabled;
                clicked => { root.action("left"); table-scope.focus(); }
            }
            Button {
                text: "Merge";
                enabled: root.actions-enabled;
                clicked => { root.action("merge"); table-scope.focus(); }
            }
            Rectangle { width: 8px; }
            Button {
                text: "Diff";
                enabled: root.diff-enabled;
                clicked => { root.diff(); }
            }
            Button {
                text: "Details";
                enabled: root.detail-enabled;
                clicked => { root.details(); }
            }
            Rectangle { width: 8px; }
            Button {
                text: "Go";
                enabled: root.go-enabled;
                primary: true;
                clicked => { root.go(); table-scope.focus(); }
            }
            Button {
                text: "Stop";
                enabled: root.stop-enabled;
                clicked => { root.stop(); }
            }
            Button {
                text: "Rescan";
                enabled: root.rescan-enabled;
                clicked => { root.rescan(); table-scope.focus(); }
            }
            Rectangle { width: 8px; }
            Button {
                text: "Change Profile";
                enabled: root.rescan-enabled;
                clicked => { root.change-profile(); }
            }
            Text {
                text: root.profile-text;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // The column headings (`setMainWindowColumnHeaders`).
        Rectangle {
            height: Theme.row-height + 4px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                HeaderCell {
                    width: Theme.replica-width;
                    label: root.replica1-heading;
                }
                HeaderCell {
                    width: Theme.arrow-width;
                    label: "Action";
                }
                HeaderCell {
                    width: Theme.replica-width;
                    label: root.replica2-heading;
                }
                HeaderCell {
                    width: Theme.status-width;
                    label: "Status";
                }
                HeaderCell {
                    horizontal-stretch: 1;
                    label: "Path";
                }
            }
        }

        table-scope := FocusScope {
            vertical-stretch: 1;
            // Screen readers see the items' list here, where the keys go,
            // with the focus on the cursor's row, as in a `KeyedList`; the
            // `ListView` is hidden from them. `list` is AccessKit's ListBox,
            // which VoiceOver treats as a container of selectable items;
            // `table` would map to a Table, whose children VoiceOver doesn't
            // treat as selectable rows.
            accessible-role: AccessibleRole.list;
            accessible-label: "Items";
            accessible-item-count: root.rows.length;
            accessible-delegate-focus: root.cursor - floor(-list.content-y / Theme.row-height);
            key-pressed(event) => {
                if root.dialog != 0 {
                    return reject;
                }
                // uigtk3's keys: the Action menu's, the arrows, and the
                // Synchronization menu's.
                if event.modifiers.control || event.modifiers.meta || event.modifiers.alt {
                    return reject;
                }
                if event.text == ">" || event.text == "." || event.text == Key.RightArrow {
                    root.action("right");
                    return accept;
                }
                if event.text == "<" || event.text == "," || event.text == Key.LeftArrow {
                    root.action("left");
                    return accept;
                }
                if event.text == "/" {
                    root.action("skip");
                    return accept;
                }
                if event.text == "m" {
                    root.action("merge");
                    return accept;
                }
                if event.text == "i" {
                    root.details();
                    return accept;
                }
                if event.text == "d" {
                    root.diff();
                    return accept;
                }
                if event.text == "I" {
                    root.ignore("path");
                    return accept;
                }
                if event.text == "E" {
                    root.ignore("ext");
                    return accept;
                }
                if event.text == "N" {
                    root.ignore("name");
                    return accept;
                }
                if event.text >= "0" && event.text <= "9" && event.text.character-count == 1 {
                    root.select-profile(event.text.to-float());
                    return accept;
                }
                if event.text == "g" {
                    root.go();
                    return accept;
                }
                if event.text == "r" {
                    root.rescan();
                    return accept;
                }
                if event.text == "a" {
                    root.proceed();
                    return accept;
                }
                if event.text == "f" {
                    root.recheck();
                    return accept;
                }
                if event.text == "p" {
                    root.change-profile();
                    return accept;
                }
                if event.text == "q" {
                    root.quit();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-cursor(1, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-cursor(-1, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.PageDown {
                    root.move-cursor(25, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.PageUp {
                    root.move-cursor(-25, event.modifiers.shift);
                    return accept;
                }
                reject
            }

            // Behind the items, a list box's background, as the style has it.
            Rectangle {
                background: Palette.control-background;
            }
            list := ListView {
                accessible-role: none;

                for row[index] in root.rows: Rectangle {
                    height: Theme.row-height;
                    background: row.selected ? Palette.accent-background
                        : Math.mod(index, 2) == 1 ? Palette.alternate-background : transparent;

                    // One accessible item per row, with a spoken summary;
                    // the cells below are hidden from screen readers.
                    accessible-role: list-item;
                    accessible-label: row.spoken;
                    accessible-item-selectable: true;
                    accessible-item-selected: row.selected;
                    accessible-item-index: index;
                    accessible-action-default => { root.row-clicked(index, false, false); }

                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                table-scope.focus();
                                root.row-clicked(index, event.modifiers.shift, event.modifiers.control);
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        Text {
                            width: Theme.replica-width;
                            text: row.replica1;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.accent-foreground : Palette.foreground;
                            accessible-role: none;
                        }
                        Text {
                            width: Theme.arrow-width;
                            text: row.arrow;
                            font-family: root.mono-font;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: Theme.arrow-color(row.arrow-kind, row.changed);
                            accessible-role: none;
                        }
                        Text {
                            width: Theme.replica-width;
                            text: row.replica2;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.accent-foreground : Palette.foreground;
                            accessible-role: none;
                        }
                        HorizontalLayout {
                            width: Theme.status-width;
                            spacing: 4px;
                            Text {
                                text: row.done == 1 ? "✓" : row.done == 2 ? "✗" : "";
                                color: row.done == 1 ? #00b000 : #ff2040;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                text: row.status;
                                font-family: root.mono-font;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: row.selected ? Palette.accent-foreground : Palette.foreground;
                                accessible-role: none;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: row.path;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.accent-foreground : Palette.foreground;
                            accessible-role: none;
                        }
                    }
                }
            }
        }

        // The details pane (`updateDetails`): the path, then the details.
        Rectangle {
            height: 5 * Theme.row-height;
            background: Palette.control-background;
            border-width: 1px;
            border-color: Palette.border;
            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    alignment: start;
                    Text {
                        text: root.details-path;
                        accessible-label: "Path";
                    }
                    Text {
                        text: root.details-text;
                        font-family: root.details-formatted ? root.mono-font : "";
                        wrap: root.details-formatted ? no-wrap : word-wrap;
                        accessible-label: "Details";
                    }
                }
            }
        }

        // The progress bar and the status line.
        Rectangle {
            height: 24px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                // The text over the bar, as GTK's progress bar shows it:
                // above it, since the style's bar is a thin line.
                VerticalLayout {
                    width: 220px;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.progress-text;
                        font-size: 10px;
                        horizontal-alignment: center;
                        accessible-label: "Progress";
                    }
                    ProgressIndicator {
                        progress: root.progress-fraction;
                        indeterminate: root.progress-pulse;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.status-text;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-label: "Status";
                }
            }
        }
    }

    // A message, with up to two buttons (warnBox, fatalError, okBox,
    // messageBox).
    if root.dialog == 1: Card {
        title: root.dialog-title;
        escape => {
            if root.dialog-cancel != "" { root.dialog-done(false); }
            else if root.dialog-ok != "" { root.dialog-done(true); }
        }
        // In a layout, so that the text is as wide as the view, from its
        // left: alone, Slint centres it, cutting off both sides of a line
        // wider than the view (a long path).
        ScrollView {
            min-height: 60px;
            preferred-height: min(message.preferred-height + 8px, 360px);
            VerticalLayout {
                message := Text {
                    text: root.dialog-message;
                    wrap: word-wrap;
                    accessible-label: "Message";
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if root.dialog-cancel != "": Button {
                text: root.dialog-cancel;
                clicked => { root.dialog-done(false); }
            }
            if root.dialog-ok != "": Button {
                text: root.dialog-ok;
                primary: true;
                clicked => { root.dialog-done(true); }
                init => { self.focus(); }
            }
        }
    }

    // The summary of a sync that left the replicas not fully synchronized
    // (`summaryBox`), with its items under "Show details".
    if root.dialog == 4: Card {
        title: root.dialog-title;
        card-width: 520px;
        escape => { root.dialog-done(true); }
        property <bool> details;
        Para {
            text: root.dialog-message;
            accessible-label: "Message";
        }
        Button {
            text: details ? "Hide details" : "Show details";
            clicked => { details = !details; }
        }
        if details: ScrollView {
            min-height: 120px;
            preferred-height: 200px;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                alignment: start;
                for entry in root.summary-entries: VerticalLayout {
                    Para {
                        text: entry.path + " — " + entry.description;
                    }
                    for error in entry.errors: Para {
                        x: 16px;
                        text: "• " + error;
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "OK";
                primary: true;
                clicked => { root.dialog-done(true); }
                init => { self.focus(); }
            }
        }
    }

    // What ssh prints at its terminal, and the answer
    // (`createPasswordDialog`): Quit ends the program.
    if root.dialog == 5: Card {
        title: root.dialog-title;
        escape => { root.dialog-done(false); }
        Para {
            text: "Connecting to '" + root.password-root + "'...";
            font-weight: 700;
        }
        ScrollView {
            min-height: 40px;
            preferred-height: min(ssh-text.preferred-height + 8px, 240px);
            // In a layout, as the message card's.
            VerticalLayout {
                ssh-text := Text {
                    text: root.dialog-message;
                    wrap: word-wrap;
                    accessible-label: "Message";
                }
            }
        }
        if root.password-editable: LineEdit {
            input-type: password;
            text <=> root.password-text;
            accessible-label: "Password";
            accepted => { root.dialog-done(true); }
            init => { self.focus(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Quit";
                clicked => { root.dialog-done(false); }
            }
            Button {
                text: "OK";
                primary: true;
                clicked => { root.dialog-done(true); }
            }
        }
    }

    // The profile manager (`getProfile`).
    if root.dialog == 6: Card {
        title: "Profile Selection";
        card-width: 600px;
        escape => { root.profile-close(); }
        Text { text: "Select a profile:"; }
        HorizontalLayout {
            spacing: 12px;
            profile-list := KeyedList {
                label: "Profiles";
                count: root.profiles.length;
                selected: root.profile-selected;
                first-focus: true;
                view-height: profile-view.visible-height;
                step(r) => { root.profile-clicked(r); }
                activate(r) => { root.profile-open(); }
                profile-view := ListView {
                    accessible-role: none;
                    content-y <=> profile-list.scroll;
                    for p[i] in root.profiles: Rectangle {
                        height: 22px;
                        background: i == root.profile-selected ? Palette.accent-background : transparent;
                        accessible-role: list-item;
                        accessible-label: p.name;
                        accessible-item-selectable: true;
                        accessible-item-selected: i == root.profile-selected;
                        accessible-item-index: i;
                        accessible-action-default => { root.profile-clicked(i); }
                        TouchArea {
                            clicked => { root.profile-clicked(i); profile-list.focus(); }
                            double-clicked => { root.profile-clicked(i); root.profile-open(); }
                        }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 12px;
                            Text {
                                width: 160px;
                                text: p.name;
                                vertical-alignment: center;
                                overflow: elide;
                                color: i == root.profile-selected ? Palette.accent-foreground : Palette.foreground;
                                accessible-role: none;
                            }
                            Text {
                                text: p.label;
                                vertical-alignment: center;
                                overflow: elide;
                                color: i == root.profile-selected ? Palette.accent-foreground : Palette.foreground;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Button {
                    text: "Add";
                    clicked => { root.profile-add(); }
                }
                Button {
                    text: "Edit";
                    enabled: root.profile-selected >= 0;
                    clicked => { root.profile-edit(); }
                }
                Button {
                    text: "Delete";
                    enabled: root.profile-selected >= 0;
                    clicked => { root.profile-delete(); }
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: "Help";
                    clicked => { root.documentation(""); }
                }
            }
        }
        Text {
            text: "Summary";
            font-weight: 700;
        }
        GridLayout {
            spacing: 6px;
            Row {
                Text { text: "First root:"; }
                Text {
                    text: root.profile-root1;
                    overflow: elide;
                    accessible-label: "First root";
                }
            }
            Row {
                Text { text: "Second root:"; }
                Text {
                    text: root.profile-root2;
                    overflow: elide;
                    accessible-label: "Second root";
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: root.manager-quit ? "Quit" : "Cancel";
                clicked => { root.profile-close(); }
            }
            Button {
                text: "Open";
                primary: true;
                enabled: root.profile-selected >= 0;
                clicked => { root.profile-open(); }
            }
        }
    }

    // The profile creation assistant (`createProfile`), a page at a time.
    if root.dialog == 7: Card {
        title: root.wiz-title;
        card-width: 600px;
        escape => { root.wizard-cancel(); }
        if root.wiz-page == 0: Para {
            text: "Welcome to the Gemel Profile Creation Assistant.\n\nClick \"Next\" to begin.";
        }
        if root.wiz-page == 1: VerticalLayout {
            spacing: 6px;
            Para {
                text: "Please enter the name of the profile and possibly a short description.";
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Profile name:"; vertical-alignment: center; width: 110px; }
                LineEdit {
                    text <=> root.wiz-name;
                    accessible-label: "Profile name";
                    edited => { root.wizard-changed(); }
                    accepted => { if root.wiz-complete { root.wizard-next(); } }
                    init => { self.focus(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Description:"; vertical-alignment: center; width: 110px; }
                LineEdit {
                    text <=> root.wiz-label;
                    accessible-label: "Description";
                    edited => { root.wizard-changed(); }
                    accepted => { if root.wiz-complete { root.wizard-next(); } }
                }
            }
            if root.wiz-exists: Text {
                text: "Profile " + root.wiz-name + " already exists.";
                font-italic: true;
                horizontal-alignment: right;
            }
        }
        if root.wiz-page == 2: VerticalLayout {
            spacing: 6px;
            Para {
                text: "You can use Gemel to synchronize a local directory with another local directory, or with a remote directory.";
            }
            Para {
                text: "Please select the kind of synchronization you want to perform.";
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Synchronization kind:"; vertical-alignment: center; }
                ComboBox {
                    model: ["Local", "Using SSH", "Through a plain TCP connection"];
                    current-index <=> root.wiz-kind;
                    accessible-label: "Synchronization kind";
                    selected => { root.wizard-changed(); }
                }
            }
            Para {
                text: root.wiz-kind-text;
            }
            if root.wiz-kind != 0: VerticalLayout {
                spacing: 6px;
                Text { text: "Configuration"; font-weight: 700; }
                Para { text: root.wiz-requirement; }
                Para { text: root.wiz-connection; }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Host:"; vertical-alignment: center; width: 60px; }
                    LineEdit {
                        text <=> root.wiz-host;
                        accessible-label: "Host";
                        edited => { root.wizard-changed(); }
                    }
                }
                if root.wiz-kind == 1: HorizontalLayout {
                    spacing: 6px;
                    Text { text: "User:"; vertical-alignment: center; width: 60px; }
                    LineEdit {
                        text <=> root.wiz-user;
                        accessible-label: "User";
                        edited => { root.wizard-changed(); }
                    }
                }
                if root.wiz-kind == 2: HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Port:"; vertical-alignment: center; width: 60px; }
                    LineEdit {
                        text <=> root.wiz-port;
                        accessible-label: "Port";
                        edited => { root.wizard-changed(); }
                    }
                }
                if root.wiz-kind == 1: Para {
                    text: "Data compression can greatly improve performance on slow connections.  However, it may slow down things on (fast) local networks.";
                }
                if root.wiz-kind == 1: CheckBox {
                    text: "Enable compression";
                    checked <=> root.wiz-compress;
                }
            }
        }
        if root.wiz-page == 3: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Please select the two"; vertical-alignment: center; }
                ComboBox {
                    model: ["directories", "files"];
                    current-index <=> root.wiz-dir-kind;
                    accessible-label: "Directories or files";
                    selected => { root.wizard-changed(); }
                }
                Text { text: "that you want to synchronize."; vertical-alignment: center; }
            }
            if root.wiz-remote-note != "": Para {
                text: root.wiz-remote-note;
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.wiz-first-label; vertical-alignment: center; width: 130px; }
                LineEdit {
                    text <=> root.wiz-first;
                    accessible-label: "First root";
                    edited => { root.wizard-changed(); }
                }
                Button {
                    text: "Browse…";
                    clicked => { root.wizard-browse(0); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.wiz-second-label; vertical-alignment: center; width: 130px; }
                if root.wiz-kind == 0: LineEdit {
                    text <=> root.wiz-second;
                    accessible-label: "Second root";
                    edited => { root.wizard-changed(); }
                }
                if root.wiz-kind == 0: Button {
                    text: "Browse…";
                    clicked => { root.wizard-browse(1); }
                }
                if root.wiz-kind != 0: LineEdit {
                    text <=> root.wiz-remote;
                    accessible-label: "Remote root";
                    edited => { root.wizard-changed(); }
                }
            }
        }
        if root.wiz-page == 4: VerticalLayout {
            spacing: 6px;
            if root.wiz-fat-shown: Para {
                text: "Select the following option if one of your directory is on a FAT partition.  This is typically the case for a USB stick.";
            }
            if root.wiz-fat-shown: CheckBox {
                text: "Synchronization involving a FAT partition";
                checked <=> root.wiz-fat;
            }
        }
        if root.wiz-page == 5: Para {
            text: root.wiz-conclusion;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Cancel";
                clicked => { root.wizard-cancel(); }
            }
            if root.wiz-page > 0: Button {
                text: "Back";
                clicked => { root.wizard-back(); }
            }
            if root.wiz-page < 5: Button {
                text: "Next";
                primary: true;
                enabled: root.wiz-complete;
                clicked => { root.wizard-next(); }
            }
            if root.wiz-page == 5: Button {
                text: "Apply";
                primary: true;
                enabled: root.wiz-complete;
                clicked => { root.wizard-apply(); }
            }
        }
    }

    // The root selection (getFirstRoot, getSecondRoot).
    if root.dialog == 2 || root.dialog == 3: Card {
        title: "Root selection";
        card-width: 560px;
        escape => { root.dialog-done(false); }
        Para {
            text: root.dialog-message;
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.dialog == 2 ? "Dir:" : "Directory:";
                vertical-alignment: center;
            }
            LineEdit {
                text <=> root.root-dir;
                accessible-label: "Directory";
                accepted => { root.dialog-done(true); }
                init => { self.focus(); }
            }
            Button {
                text: "Browse…";
                enabled: root.root-kind == 0;
                clicked => { root.browse-root(); }
            }
        }
        // uigtk3's rows: the kind (radio buttons there), then the host,
        // the user and the port; here the user has a row of its own, so
        // that the fields fit the card.
        if root.dialog == 3: HorizontalLayout {
            alignment: start;
            ComboBox {
                model: ["Local", "SSH", "Socket"];
                current-index <=> root.root-kind;
                accessible-label: "Kind";
            }
        }
        if root.dialog == 3: HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Host:";
                vertical-alignment: center;
            }
            LineEdit {
                text <=> root.root-host;
                enabled: root.root-kind != 0;
                accessible-label: "Host";
            }
            Text {
                text: "Port:";
                vertical-alignment: center;
            }
            LineEdit {
                width: 90px;
                text <=> root.root-port;
                enabled: root.root-kind == 2;
                accessible-label: "Port";
            }
        }
        if root.dialog == 3: HorizontalLayout {
            spacing: 6px;
            Text {
                text: "(Optional) User:";
                vertical-alignment: center;
            }
            LineEdit {
                text <=> root.root-user;
                enabled: root.root-kind == 1;
                accessible-label: "User";
            }
        }
        if root.root-error != "": Para {
            text: root.root-error;
            color: #d23c3c;
        }
        HorizontalLayout {
            spacing: 8px;
            // `getSecondRoot`'s: how roots are picked.
            if root.dialog == 3: Button {
                text: "Help";
                clicked => { root.root-help(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                clicked => { root.dialog-done(false); }
            }
            Button {
                text: "OK";
                primary: true;
                clicked => { root.dialog-done(true); }
            }
        }
    }

    // The profile editor (`editProfile`).
    if root.dialog == 8: Card {
        title: root.editor-title;
        card-width: 680px;
        escape => { root.editor-close(false); }
        Text { text: "Preferences:"; }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                HorizontalLayout {
                    height: 22px;
                    TouchArea {
                        width: 180px;
                        accessible-role: button;
                        accessible-label: "Name";
                        accessible-action-default => { root.editor-sort(); }
                        clicked => { root.editor-sort(); }
                        HeaderCell { label: "Name " + (root.editor-descending ? "▼" : "▲"); }
                    }
                    HeaderCell { width: 90px; label: "Type"; }
                    HeaderCell { label: "Value"; }
                }
                editor-list := KeyedList {
                    label: "Preferences";
                    count: root.editor-rows.length;
                    selected: root.editor-selected;
                    first-focus: true;
                    view-height: editor-view.visible-height;
                    step(r) => { root.editor-clicked(r); }
                    activate(r) => { root.editor-activated(r); }
                    editor-view := ListView {
                        accessible-role: none;
                        content-y <=> editor-list.scroll;
                        for r[i] in root.editor-rows: ListRow {
                            selected: i == root.editor-selected;
                            label: r.name;
                            index: i;
                            clicked => { root.editor-clicked(i); editor-list.focus(); }
                            double-clicked => { root.editor-clicked(i); root.editor-activated(i); }
                            HorizontalLayout {
                                padding-left: 4px;
                                for cell[c] in [r.name, r.type, r.value]: Text {
                                    width: c == 0 ? 176px : c == 1 ? 90px : self.preferred-width;
                                    text: cell;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: i == root.editor-selected ? Palette.accent-foreground : Palette.foreground;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Button {
                    text: "Add";
                    clicked => { root.editor-add(); }
                }
                Button {
                    text: "Edit";
                    enabled: root.editor-selected >= 0;
                    clicked => { root.editor-edit(); }
                }
                Button {
                    text: "Delete";
                    enabled: root.editor-selected >= 0;
                    clicked => { root.editor-delete(); }
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: "Help";
                    clicked => { root.documentation("running"); }
                }
            }
        }
        DocPane {
            shown: root.doc-shown;
            short: root.doc-short;
            long: root.doc-long;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Apply";
                enabled: root.editor-modified;
                clicked => { root.editor-apply(); }
            }
            Button {
                text: "Cancel";
                clicked => { root.editor-close(false); }
            }
            Button {
                text: "OK";
                primary: true;
                clicked => { root.editor-close(true); }
            }
        }
    }

    // A preference edited (`editPreference`).
    if root.dialog == 9: Card {
        title: "Edit the Preference";
        card-width: 560px;
        escape => { root.pe-close(false); }
        GridLayout {
            spacing: 6px;
            Row {
                Text { text: "Preference:"; }
                Text { text: root.pe-name; accessible-label: "Preference"; }
            }
            Row {
                Text { text: "Description:"; }
                Para { text: root.pe-description; accessible-label: "Description"; }
            }
            Row {
                Text { text: "Type:"; }
                Text { text: root.pe-type; accessible-label: "Type"; }
            }
            Row {
                Text { text: "Value:"; vertical-alignment: top; }
                if root.pe-kind == 0: RadioGroup {
                    orientation: horizontal;
                    accessible-label: "Value";
                    selected(value) => { root.pe-truth = value == "True"; }
                    // The value as it is when the dialog opens; the group
                    // has it from then on.
                    RadioButton {
                        text: "True";
                        checked: root.pe-truth;
                    }
                    RadioButton {
                        text: "False";
                        checked: !root.pe-truth;
                    }
                }
                if root.pe-kind == 1: LineEdit {
                    text <=> root.pe-text;
                    accessible-label: "Value";
                    accepted => { root.pe-close(true); }
                    init => { self.focus(); }
                }
                if root.pe-kind == 2: HorizontalLayout {
                    spacing: 12px;
                    value-list := KeyedList {
                        label: "Value";
                        count: root.pe-items.length;
                        selected: root.pe-item;
                        list-height: 160px;
                        first-focus: true;
                        view-height: value-view.visible-height;
                        step(r) => { root.pe-item-clicked(r); }
                        value-view := ListView {
                            accessible-role: none;
                            content-y <=> value-list.scroll;
                            for v[i] in root.pe-items: ListRow {
                                selected: i == root.pe-item;
                                label: v;
                                index: i;
                                clicked => { root.pe-item-clicked(i); value-list.focus(); }
                                Text {
                                    x: 4px;
                                    text: v;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: i == root.pe-item ? Palette.accent-foreground : Palette.foreground;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        Button {
                            text: "Add";
                            clicked => { root.pe-add(); }
                        }
                        Button {
                            text: "Remove";
                            enabled: root.pe-item >= 0;
                            clicked => { root.pe-remove(); }
                        }
                        Button {
                            text: "Edit";
                            enabled: root.pe-item >= 0 && root.pe-items[root.pe-item] != root.pe-entry;
                            clicked => { root.pe-edit(); }
                        }
                        Button {
                            text: "Up";
                            enabled: root.pe-item > 0;
                            clicked => { root.pe-up(); }
                        }
                        Button {
                            text: "Down";
                            enabled: root.pe-item >= 0 && root.pe-item < root.pe-items.length - 1;
                            clicked => { root.pe-down(); }
                        }
                    }
                }
            }
            if root.pe-kind == 2: Row {
                Text { text: "Edited item:"; }
                LineEdit {
                    text <=> root.pe-entry;
                    accessible-label: "Edited item";
                    accepted => { root.pe-add(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Help";
                clicked => { root.documentation("running"); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                clicked => { root.pe-close(false); }
            }
            Button {
                text: "OK";
                primary: true;
                clicked => { root.pe-close(true); }
            }
        }
    }

    // The tree a preference is added from (`addPreference`).
    if root.dialog == 10: Card {
        title: "Add a Preference";
        card-width: 600px;
        escape => { root.tree-close(false); }
        HorizontalLayout {
            Text {
                text: "Preferences:";
                vertical-alignment: bottom;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.tree-all ? "Collapse all" : "Expand all";
                clicked => { root.tree-toggle-all(); }
            }
        }
        tree-list := KeyedList {
            accessible-role: tree;
            label: "Preferences";
            count: root.tree-rows.length;
            selected: root.tree-selected;
            list-height: 240px;
            tree: true;
            first-focus: true;
            view-height: tree-view.visible-height;
            step(r) => { root.tree-select(r); }
            activate(r) => { root.tree-activated(r); }
            left(r) => { root.tree-left(r); }
            right(r) => { root.tree-right(r); }
            tree-view := ListView {
                accessible-role: none;
                content-y <=> tree-list.scroll;
                for r[i] in root.tree-rows: ListRow {
                    selected: i == root.tree-selected;
                    label: r.title;
                    index: i;
                    accessible-expandable: r.parent;
                    accessible-expanded: r.expanded;
                    accessible-action-expand => { if r.parent && !r.expanded { root.tree-clicked(i); } }
                    accessible-action-default => { root.tree-select(i); }
                    clicked => { root.tree-clicked(i); tree-list.focus(); }
                    double-clicked => { root.tree-activated(i); }
                    Text {
                        x: 4px + r.depth * 18px;
                        text: (r.parent ? (r.expanded ? "▾ " : "▸ ") : "") + r.title;
                        vertical-alignment: center;
                        overflow: elide;
                        font-weight: r.kind == 0 ? 700 : 400;
                        font-italic: r.kind == 1;
                        color: i == root.tree-selected ? Palette.accent-foreground : Palette.foreground;
                        accessible-role: none;
                    }
                }
            }
        }
        DocPane {
            shown: root.doc-shown;
            short: root.doc-short;
            long: root.doc-long;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Cancel";
                clicked => { root.tree-close(false); }
            }
            Button {
                text: "Add";
                primary: true;
                enabled: root.tree-can-add;
                clicked => { root.tree-close(true); }
            }
        }
    }
}

// The statistics window (`statistics`): the rates of what is sent to and
// received from the server, as graphs, and a table of the rates and
// bytes on the client's side, the server's and in all.
export component StatsWindow inherits Window {
    title: "Statistics";
    preferred-width: 400px;

    in property <string> emission;
    in property <string> reception;
    // Rows: reception rate, data received, file data written; columns:
    // client, server, total.
    in property <[[string]]> table: [["", "", ""], ["", "", ""], ["", "", ""]];

    // Close, or Escape: hides the window (`close()` is Slint's own).
    callback close-window();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        for graph[i] in [root.emission, root.reception]: Rectangle {
            height: 50px;
            background: white;
            border-width: 1px;
            border-color: Palette.border;
            accessible-role: image;
            accessible-label: i == 0 ? "Emission rate" : "Reception rate";
            Path {
                width: parent.width;
                height: parent.height;
                commands: graph;
                viewbox-width: 320;
                viewbox-height: 50;
                fill: black;
            }
        }
        GridLayout {
            spacing: 6px;
            Row {
                Text { text: ""; }
                Text { text: "Client"; font-weight: 700; horizontal-alignment: right; }
                Text { text: "Server"; font-weight: 700; horizontal-alignment: right; }
                Text { text: "Total"; font-weight: 700; horizontal-alignment: right; }
            }
            for row[r] in root.table: Row {
                Text { text: r == 0 ? "Reception rate" : r == 1 ? "Data received" : "File data written"; }
                for cell[c] in row: Text {
                    text: cell;
                    horizontal-alignment: right;
                    accessible-label: (r == 0 ? "Reception rate" : r == 1 ? "Data received" : "File data written")
                        + ", " + (c == 0 ? "client" : c == 1 ? "server" : "total");
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => { root.close-window(); }
            }
        }
    }
}

// A diff (`diffCmd`'s `messageBox`), a window of its own: added lines
// green, removed ones red, locations cyan.
export component DiffWindow inherits Window {
    in property <string> window-title;
    title: root.window-title;
    preferred-width: 640px;
    preferred-height: 420px;

    in property <[DiffLine]> lines;
    in property <string> mono-font: "Menlo";

    // Close, or Escape: hides the window (`close()` is Slint's own).
    callback close-window();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        ScrollView {
            VerticalLayout {
                alignment: start;
                for line in root.lines: Text {
                    text: line.text;
                    font-family: root.mono-font;
                    font-weight: line.kind == 3 ? 700 : 400;
                    color: line.kind == 1 ? #00a000 : line.kind == 2 ? #d00000 : line.kind == 3 ? #008b8b : Palette.foreground;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => { root.close-window(); }
            }
        }
    }
}

// The manual (`documentation`), a window of its own: a tab for each of
// its sections with a topic, and the section chosen, as laid out on 80
// columns.
export component DocWindow inherits Window {
    title: "Documentation";
    preferred-width: 900px;
    preferred-height: 520px;

    // The sections' names.
    in property <[string]> pages;
    in property <int> current;
    // The lines of the section chosen, and how far down they are shown.
    in property <[string]> lines;
    in-out property <length> scroll <=> text.content-y;
    in property <string> mono-font: "Menlo";

    callback select(page: int);
    // Close, or Escape: hides the window (`close()` is Slint's own).
    callback close-window();

    // The keys: Escape closes, wherever the focus is; the tabs' own take
    // the rest.
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-window();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                // The tabs, which take the keys when the window opens: Up
                // and Down (or Ctrl+Page Up and Page Down) go to the tab
                // before or after. Screen readers see the tab list here,
                // with the focus on the tab chosen.
                tabs := FocusScope {
                    width: 170px;
                    init => { self.focus(); }
                    accessible-role: tab-list;
                    accessible-label: "Sections";
                    accessible-delegate-focus: root.current;
                    key-pressed(event) => {
                        if event.modifiers.alt || event.modifiers.meta {
                            return reject;
                        }
                        if event.text == Key.UpArrow || (event.modifiers.control && event.text == Key.PageUp) {
                            root.select(max(0, root.current - 1));
                            return accept;
                        }
                        if event.text == Key.DownArrow || (event.modifiers.control && event.text == Key.PageDown) {
                            root.select(min(root.pages.length - 1, root.current + 1));
                            return accept;
                        }
                        reject
                    }
                    VerticalLayout {
                        alignment: start;
                        for name[i] in root.pages: Rectangle {
                            height: tab-name.preferred-height + 8px;
                            background: i == root.current ? Palette.accent-background : transparent;
                            accessible-role: tab;
                            accessible-label: name;
                            accessible-item-selectable: true;
                            accessible-item-selected: i == root.current;
                            accessible-item-index: i;
                            accessible-action-default => { root.select(i); }
                            TouchArea {
                                clicked => { root.select(i); tabs.focus(); }
                            }
                            tab-name := Text {
                                x: 4px;
                                width: parent.width - 8px;
                                text: name;
                                wrap: word-wrap;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: i == root.current ? Palette.accent-foreground : Palette.foreground;
                                accessible-role: none;
                            }
                        }
                    }
                }
                Rectangle {
                    background: Palette.control-background;
                    border-width: 1px;
                    border-color: Palette.border;
                    text := ListView {
                        accessible-role: tab-panel;
                        accessible-label: root.pages[root.current];
                        for line in root.lines: Text {
                            x: 4px;
                            text: line;
                            font-family: root.mono-font;
                            wrap: no-wrap;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "Close";
                    clicked => { root.close-window(); }
                }
            }
        }
    }
}
