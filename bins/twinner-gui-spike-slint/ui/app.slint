// Throwaway GUI spike: the recon-table slice in Slint 1.18.
// See §6 of docs/unison-port-analysis.md.
//
// StandardTableView is single-select with text-only cells, so the recon
// table is a custom one on ListView. Selection, sorting and directions live
// in Rust (twinner-gui-spike-model); this file only renders rows and
// forwards input.

import { Button, ListView, LineEdit, Palette } from "std-widgets.slint";

export struct RowData {
    path: string,
    left: string,
    // 0 unchanged, 1 props, 2 changed, 3 new, 4 deleted
    left-kind: int,
    right: string,
    right-kind: int,
    arrow: string,
    // 0 conflict, 1 skip, 2 left-to-right, 3 right-to-left
    direction-kind: int,
    size: string,
    progress: float,
    selected: bool,
    spoken: string,
}

global Theme {
    out property <length> row-height: 20px;
    out property <length> status-width: 80px;
    out property <length> arrow-width: 56px;
    out property <length> size-width: 80px;
    out property <length> progress-width: 110px;

    public pure function status-color(kind: int) -> color {
        if kind == 1 { return #8c8cc8; }
        if kind == 2 { return #e6aa1e; }
        if kind == 3 { return #3caa50; }
        if kind == 4 { return #d23c3c; }
        return transparent;
    }

    public pure function direction-color(kind: int) -> color {
        if kind == 0 { return #d23c3c; }
        if kind == 1 { return #888888; }
        return #3c82d2;
    }
}

component StatusCell inherits HorizontalLayout {
    in property <string> label;
    in property <int> kind;
    width: Theme.status-width;
    spacing: 4px;
    alignment: start;
    // The per-row status icon.
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: Theme.status-color(root.kind);
    }
    Text {
        text: root.label;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component HeaderCell inherits TouchArea {
    in property <string> label;
    in property <bool> active;
    in property <bool> ascending;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 4px;
        width: parent.width - 4px;
        text: root.label + (root.active ? (root.ascending ? " ▲" : " ▼") : "");
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AppWindow inherits Window {
    title: "twinner GUI spike — Slint";
    preferred-width: 1000px;
    preferred-height: 700px;
    always-on-top: root.on-top;

    in property <[RowData]> rows;
    in property <string> status-text;
    in property <string> root-text;
    // "path", "status" or "size"
    in property <string> sort-key;
    in property <bool> sort-ascending;
    // Set by --bench to keep the window in front: Slint skips rendering while
    // the window is occluded (a locked screen still occludes it).
    in property <bool> on-top;
    in-out property <bool> ssh-open;
    in-out property <string> ssh-password;

    callback row-clicked(index: int, shift: bool, command: bool);
    callback direction-key(key: string);
    callback move-cursor(delta: int, extend: bool);
    callback select-all();
    callback sort(key: string);
    callback choose-root();
    callback connect-ssh();
    callback ssh-done(ok: bool);

    // Scrolls so that row `index` is visible.
    public function bring-into-view(index: int) {
        if index * Theme.row-height < -list.content-y {
            list.content-y = -index * Theme.row-height;
        } else if (index + 1) * Theme.row-height > -list.content-y + list.visible-height {
            list.content-y = -((index + 1) * Theme.row-height - list.visible-height);
        }
    }

    // Scrolls row `index` to the top (used by --bench).
    public function scroll-to(index: int) {
        list.content-y = -index * Theme.row-height;
    }

    public function focus-table() {
        table-scope.focus();
    }

    // Native on macOS (via muda inside Slint). `Control` is Cmd there.
    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Choose Root…";
                shortcut: @keys(Control + O);
                activated => { root.choose-root(); }
            }
            MenuItem {
                title: "Connect over SSH…";
                shortcut: @keys(Control + K);
                activated => { root.connect-ssh(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Select All";
                shortcut: @keys(Control + A);
                activated => { root.select-all(); }
            }
        }
        Menu {
            title: "Actions";
            MenuItem {
                title: "Propagate Left to Right  (>)";
                activated => { root.direction-key(">"); }
            }
            MenuItem {
                title: "Propagate Right to Left  (<)";
                activated => { root.direction-key("<"); }
            }
            MenuItem {
                title: "Skip  (/)";
                activated => { root.direction-key("/"); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Sort by Path";
                shortcut: @keys(Control + "1");
                activated => { root.sort("path"); }
            }
            MenuItem {
                title: "Sort by Status";
                shortcut: @keys(Control + "2");
                activated => { root.sort("status"); }
            }
            MenuItem {
                title: "Sort by Size";
                shortcut: @keys(Control + "3");
                activated => { root.sort("size"); }
            }
        }
    }

    VerticalLayout {
        HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            Button {
                text: "Choose root…";
                clicked => { root.choose-root(); }
            }
            Button {
                text: "Connect over SSH…";
                clicked => { root.connect-ssh(); }
            }
            Button {
                text: "Left to right  >";
                clicked => { root.direction-key(">"); table-scope.focus(); }
            }
            Button {
                text: "Right to left  <";
                clicked => { root.direction-key("<"); table-scope.focus(); }
            }
            Button {
                text: "Skip  /";
                clicked => { root.direction-key("/"); table-scope.focus(); }
            }
            Text {
                text: "root: " + root.root-text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // Column header.
        Rectangle {
            height: Theme.row-height + 4px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                HeaderCell {
                    horizontal-stretch: 1;
                    label: "Path";
                    active: root.sort-key == "path";
                    ascending: root.sort-ascending;
                    clicked => { root.sort("path"); }
                }
                HeaderCell {
                    width: Theme.status-width;
                    label: "Left";
                    active: root.sort-key == "status";
                    ascending: root.sort-ascending;
                    clicked => { root.sort("status"); }
                }
                HeaderCell {
                    width: Theme.arrow-width;
                    label: "Action";
                    clicked => { root.sort("status"); }
                }
                HeaderCell {
                    width: Theme.status-width;
                    label: "Right";
                    clicked => { root.sort("status"); }
                }
                HeaderCell {
                    width: Theme.size-width;
                    label: "Size";
                    active: root.sort-key == "size";
                    ascending: root.sort-ascending;
                    clicked => { root.sort("size"); }
                }
                HeaderCell {
                    width: Theme.progress-width;
                    label: "Progress";
                }
                // Room for the scroll bar.
                Rectangle { width: 10px; }
            }
        }

        table-scope := FocusScope {
            vertical-stretch: 1;
            key-pressed(event) => {
                if root.ssh-open {
                    return reject;
                }
                if event.text == ">" || event.text == "<" || event.text == "/" {
                    root.direction-key(event.text);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-cursor(1, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-cursor(-1, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.PageDown {
                    root.move-cursor(25, event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.PageUp {
                    root.move-cursor(-25, event.modifiers.shift);
                    return accept;
                }
                reject
            }

            list := ListView {
                // ListView is already `list` (AccessKit ListBox, which VoiceOver
                // treats as a container of selectable items); `table` would
                // map to a Table, whose children VoiceOver doesn't treat as
                // selectable rows.
                accessible-label: "Reconciliation items";
                accessible-item-count: root.rows.length;

                for row[index] in root.rows: Rectangle {
                    height: Theme.row-height;
                    background: row.selected ? Palette.selection-background
                        : Math.mod(index, 2) == 1 ? Palette.alternate-background : transparent;

                    // One accessible item per row, with a spoken summary;
                    // the cells below are hidden from screen readers.
                    accessible-role: list-item;
                    accessible-label: row.spoken;
                    accessible-item-selectable: true;
                    accessible-item-selected: row.selected;
                    accessible-item-index: index;
                    accessible-action-default => { root.row-clicked(index, false, false); }

                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                table-scope.focus();
                                root.row-clicked(index, event.modifiers.shift, event.modifiers.control);
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 1;
                            text: row.path;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.selection-foreground : Palette.foreground;
                            accessible-role: none;
                        }
                        StatusCell {
                            label: row.left;
                            kind: row.left-kind;
                        }
                        Text {
                            width: Theme.arrow-width;
                            text: row.arrow;
                            font-family: "Menlo";
                            vertical-alignment: center;
                            color: Theme.direction-color(row.direction-kind);
                            accessible-role: none;
                        }
                        StatusCell {
                            label: row.right;
                            kind: row.right-kind;
                        }
                        Text {
                            width: Theme.size-width;
                            text: row.size;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        Rectangle {
                            width: Theme.progress-width;
                            if row.progress > 0: Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 10px;
                                border-radius: 3px;
                                background: Palette.alternate-background;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * row.progress;
                                    border-radius: 3px;
                                    background: Palette.accent-background;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 24px;
            background: Palette.alternate-background;
            Text {
                x: 6px;
                text: root.status-text;
                vertical-alignment: center;
            }
        }
    }

    // The modal SSH-password prompt: a scrim that swallows input plus a
    // dialog card. (Slint's `Dialog` is a separate top-level window; a
    // window-modal sheet is not available.)
    if root.ssh-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.ssh-done(false);
                    return accept;
                }
                reject
            }
            Rectangle {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 3;
                width: 360px;
                height: 170px;
                border-radius: 8px;
                background: Palette.background;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000060;
                accessible-role: groupbox;
                accessible-label: "SSH password";
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: "SSH password";
                        font-weight: 700;
                        font-size: 15px;
                    }
                    Text { text: "jcomellas@example.org's password:"; }
                    password-edit := LineEdit {
                        input-type: password;
                        text <=> root.ssh-password;
                        accessible-label: "Password";
                        accepted => { root.ssh-done(true); }
                        init => { self.focus(); }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: "Cancel";
                            clicked => { root.ssh-done(false); }
                        }
                        Button {
                            text: "Connect";
                            primary: true;
                            clicked => { root.ssh-done(true); }
                        }
                    }
                }
            }
        }
    }
}
